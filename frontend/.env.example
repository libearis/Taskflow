# Used when running the frontend natively (no Docker) — see
# docs/RUNNING_WITHOUT_DOCKER.md. Copy this to frontend/.env; Vite reads
# VITE_-prefixed vars from a .env file in this frontend/ folder.
#
# Note these are NOT secrets: Vite bakes them into the built JS bundle that
# ships to the browser. Never put a real credential in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_GRPC_WEB_URL=http://localhost:8081
