# Used when running the backend natively (no Docker) — see
# docs/RUNNING_WITHOUT_DOCKER.md. Copy this to backend/.env; pydantic-settings
# (see app/config.py) reads it relative to the working directory the app is
# started from, i.e. this backend/ folder.
#
# Plain `localhost`, not host.docker.internal — there's no container in the
# way when running natively.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/taskflow

MONGO_URL=mongodb://localhost:27017
MONGO_DB=taskflow
HTTP_PORT=8000
GRPC_PORT=50051
PROJECTOR_POLL_INTERVAL_SECONDS=1
