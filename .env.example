# Read only by `docker compose up`, via ${DATABASE_URL} in docker-compose.yml
# — Compose looks for a .env file next to docker-compose.yml automatically.
# This is the ONE value that differs per machine: the backend container's
# connection to a native Postgres running on this machine (see
# docs/RUNNING_WITHOUT_DOCKER.md for why Postgres isn't containerized here).
#
# host.docker.internal = "the machine that's running Docker", reachable from
# inside a container. Replace <password> with your own native Postgres
# password, and adjust the port if your install isn't on 5432.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@host.docker.internal:5432/taskflow

# Everything else the backend/frontend need has its own .env.example in its
# own directory (backend/.env.example, frontend/.env.example) — this file is
# Docker Compose's file, not a shared app-wide config.
